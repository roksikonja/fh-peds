---
/**
 * Site footer.
 *
 * Left:  copyright + UKC Ljubljana attribution.
 * Right: full logos linking to the two partner organisations.
 */
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__copy">
      &copy; {year} Univerzitetni klinični center Ljubljana
    </p>
    <div class="site-footer__logos">
      <a href="https://www.kclj.si/" target="_blank" rel="noopener noreferrer" aria-label="Univerzitetni klinični center Ljubljana">
        <img src="/logos/UKC-Logo.png" alt="Univerzitetni klinični center Ljubljana" class="site-footer__logo" />
      </a>
      <a href="https://latticeflow.ai/" target="_blank" rel="noopener noreferrer" aria-label="LatticeFlow AI">
        <img src="/logos/LatticeFlowAI-Logo.png" alt="LatticeFlow AI" class="site-footer__logo" />
      </a>
    </div>
  </div>
</footer>
