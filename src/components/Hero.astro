---
/**
 * Page hero block — eyebrow pill + large serif headline + optional subtitle.
 *
 * Headline supports inline HTML (e.g. `<em>` for italic accent words) via
 * the `headline` prop, which is rendered with `set:html`.
 */
interface Props {
  eyebrow?: string;
  headline: string;   // may contain <em> / <br> HTML
  subtitle?: string;  // may contain HTML
}
const { eyebrow, headline, subtitle } = Astro.props;
---

<div class="page-hero">
  {eyebrow && <span class="page-hero__eyebrow">{eyebrow}</span>}
  <h1 set:html={headline} />
  {subtitle && <p set:html={subtitle} />}
</div>
