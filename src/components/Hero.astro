---
/**
 * Page hero block — single H1 + optional subtitle.
 *
 * No eyebrow / super-title; the navbar already names the page.
 * `headline` may contain inline HTML (e.g. `<br>`); it is rendered via
 * `set:html`.
 */
interface Props {
  headline: string;
  subtitle?: string;
}
const { headline, subtitle } = Astro.props;
---

<div class="page-hero">
  <h1 set:html={headline} />
  {subtitle && <p set:html={subtitle} />}
</div>
