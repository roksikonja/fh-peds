---
/**
 * Workflow diagram — three rounded rectangles connected by arrows that
 * summarise the clinical workflow:
 *
 *   Measure (doctor) → Predict (algorithm) → Diagnose (doctor)
 *
 * Pure inline SVG so it scales crisply. Each step's content (emoji + title)
 * lives inside a <foreignObject> so we can lay them out side-by-side with
 * flexbox and use the user's system emoji font.
 *
 * Highlight state is driven by `calculator.ts`, which sets a
 * `data-state="filling" | "predicted"` attribute on this <svg>. CSS then
 * cross-fades the box colours via a long `transition: …` on the relevant
 * properties.
 */

interface Step {
  id: 'measure' | 'predict' | 'diagnose';
  icon: string;
  title: string;
}

const steps: Step[] = [
  { id: 'measure',  icon: '📏', title: 'Measure' },
  { id: 'predict',  icon: '🤖', title: 'Predict' },
  { id: 'diagnose', icon: '🩺', title: 'Diagnose' },
];

// Geometry (viewBox units = px-ish, scales to the container width).
// BOX_H matches the rendered height of the top navbar (~53px). Navbar
// height is set by its tallest child — the nav links: 11px font ×
// line-height 1.6 = ~17.6px text + padding 0.5rem × 2 = 16px → ~33.6px.
// Plus the navbar's own padding 0.55rem × 2 = ~17.6px and a 2px border:
// 33.6 + 17.6 + 2 ≈ 53.
const W = 1040;
const H = 80;
const BOX_W = 240;
const BOX_H = 53;
// Fully-rounded pill, matching the navbar's `border-radius: 999px`.
const BOX_R = BOX_H / 2;
const CY = H / 2;
const CENTERS = [BOX_W / 2 + 5, W / 2, W - BOX_W / 2 - 5];
---

<svg
  class="workflow-diagram"
  id="workflow-diagram"
  viewBox={`0 0 ${W} ${H}`}
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-labelledby="workflow-title"
>
  <title id="workflow-title">
    Clinical workflow: doctor measures, algorithm predicts, doctor diagnoses.
  </title>

  <defs>
    <marker
      id="wf-arrow"
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0 0 L10 5 L0 10 z" class="workflow-diagram__arrow-head" />
    </marker>
  </defs>

  <!-- Connectors (drawn first so the boxes overlap them cleanly) -->
  <line
    x1={CENTERS[0] + BOX_W / 2 - 2} y1={CY}
    x2={CENTERS[1] - BOX_W / 2 + 2} y2={CY}
    class="workflow-diagram__arrow"
    marker-end="url(#wf-arrow)"
  />
  <line
    x1={CENTERS[1] + BOX_W / 2 - 2} y1={CY}
    x2={CENTERS[2] - BOX_W / 2 + 2} y2={CY}
    class="workflow-diagram__arrow"
    marker-end="url(#wf-arrow)"
  />

  {steps.map((step, i) => (
    <g class={`workflow-diagram__step workflow-diagram__step--${step.id}`} data-step={step.id}>
      <rect
        x={CENTERS[i] - BOX_W / 2}
        y={CY - BOX_H / 2}
        width={BOX_W}
        height={BOX_H}
        rx={BOX_R}
        ry={BOX_R}
        class="workflow-diagram__box"
      />
      <foreignObject
        x={CENTERS[i] - BOX_W / 2}
        y={CY - BOX_H / 2}
        width={BOX_W}
        height={BOX_H}
      >
        <div xmlns="http://www.w3.org/1999/xhtml" class="workflow-diagram__content">
          <span class="workflow-diagram__emoji">{step.icon}</span>
          <span class="workflow-diagram__title">{step.title}</span>
        </div>
      </foreignObject>
    </g>
  ))}
</svg>
