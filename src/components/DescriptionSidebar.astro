---
/**
 * Left column: accordion of field descriptions.
 *
 * Every field name is visible at all times as the summary of a <details>
 * element. The description body (pre-rendered markdown + KaTeX) is collapsed
 * by default and expands on click — or programmatically, when the
 * corresponding form field gains focus (see scripts/calculator.ts).
 *
 * The ordering here mirrors CalculatorForm.astro so the column reads in
 * the same order as the form.
 */
import { getCollection, render } from 'astro:content';

// Same order as the form fields in CalculatorForm.astro:
// required group first, then optional group.
const FIELD_ORDER = [
  // Required
  'age',
  'gender',
  'ldl_cholesterol',
  // Optional
  'fh_high_cholesterol',
  'fh_premature_cad',
  'fh_pad_cvi',
  'fh_xant',
  'fh_acrus_senilis',
  'total_cholesterol',
  'hdl_cholesterol',
  'tag',
  'lp_a',
  'bmi',
] as const;

const entries = await getCollection('descriptions');

// Map id (without `.md`) → entry, then render each into a <Content /> plus
// extract the H1 text from the markdown body for the always-visible label.
const byId = new Map(entries.map((e) => [e.id.replace(/\.md$/, ''), e]));

const items = await Promise.all(
  FIELD_ORDER.map(async (id) => {
    const entry = byId.get(id);
    if (!entry) return null;
    const { Content } = await render(entry);
    // First markdown line is `# Heading` — strip the leading `# ` to get the
    // display label for the accordion summary.
    const firstLine = entry.body?.split(/\r?\n/, 1)[0] ?? '';
    const label = firstLine.replace(/^#\s*/, '').trim() || id;
    return { id, label, Content };
  })
).then((arr) => arr.filter((x): x is NonNullable<typeof x> => x !== null));
---

<aside class="desc-sidebar" id="desc-sidebar">
  <div class="section-head">Parameters</div>

  <ul class="desc-accordion" role="list">
    {
      items.map(({ id, label, Content }) => (
        <li class="desc-accordion__item" data-desc-id={id}>
          <details class="desc-accordion__details">
            <summary class="desc-accordion__summary">
              <span class="desc-accordion__label">{label}</span>
              <span class="desc-accordion__chevron" aria-hidden="true">
                ▾
              </span>
            </summary>
            <div class="desc-accordion__body">
              <Content />
            </div>
          </details>
        </li>
      ))
    }
  </ul>
</aside>
